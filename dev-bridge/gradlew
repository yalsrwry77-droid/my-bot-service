#!/bin/sh
# Gradle wrapper script (minimal). Requires gradle-wrapper.jar in gradle/wrapper/.
# If missing, generate it once with: gradle wrapper --gradle-version 8.7
# (Android Studio does this automatically on first sync.)
APP_BASE_NAME=`basename "$0"`
APP_HOME=`cd "${APP_BASE_NAME%/*}" >/dev/null 2>&1 && pwd -P` || exit
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
exec java $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
